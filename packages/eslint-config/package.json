{
  "name": "@pplancq/eslint-config",
  "version": "7.0.0",
  "license": "MIT",
  "description": "pplancq eslint config",
  "author": "pplancq <paul.plancq@outlook.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pplancq/dev-tools.git",
    "directory": "packages/eslint-config"
  },
  "scripts": {
    "docs:generate": "node scripts/generate-docs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:eslint": "eslint \"**/*.{js,mjs}\"",
    "lint:eslint:fix": "eslint \"**/*.{js,mjs}\" --fix",
    "lint:prettier": "prettier . --check --ignore-unknown",
    "lint:prettier:fix": "prettier . --write --ignore-unknown"
  },
  "files": [
    "bin",
    "rules",
    "main.js",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "bugs": {
    "url": "https://github.com/pplancq/dev-tools/issues"
  },
  "type": "module",
  "main": "main.js",
  "bin": {
    "init-eslint-config": "bin/init.mjs"
  },
  "keywords": [
    "eslint",
    "config"
  ],
  "dependencies": {
    "@eslint-react/kit": "^5.30.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react-dom": "^5.30.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-jsx": "^5.30.2",
    "eslint-plugin-react-x": "^5.30.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.14.0"
  },
  "peerDependencies": {
    "eslint": "^9.14.0 || ^10.0.0",
    "prettier": "^3.2.5"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    },
    "eslint-plugin-prettier": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-prettier": "^5.5.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "prettier": "@pplancq/prettier-config",
  "lint-staged": {
    "*.(js|mjs)": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  }
}
