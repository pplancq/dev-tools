{
  "name": "@pplancq/react-template",
  "version": "2.10.3",
  "license": "MIT",
  "description": "react template",
  "author": "pplancq <paul.plancq@outlook.fr>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pplancq/dev-tools.git",
    "directory": "packages/react-template"
  },
  "type": "module",
  "bin": {
    "template-install": "bin/template-install.js"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "start": "rsbuild dev",
    "start:mock": "rsbuild dev --env-mode mock",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "node scripts/test.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "node scripts/playwright.js test",
    "test:e2e:watch": "node scripts/playwright.js test --watch",
    "test:e2e:ui": "node scripts/playwright.js test --ui",
    "lint": "node scripts/lint.js",
    "lint:eslint": "eslint \"**/*.{js,jsx,mjs,ts,tsx}\"",
    "lint:eslint:fix": "eslint \"**/*.{js,jsx,mjs,ts,tsx}\" --fix",
    "lint:stylelint": "stylelint \"**/*.{scss,css}\"",
    "lint:stylelint:fix": "stylelint \"**/*.{scss,css}\" --fix",
    "lint:prettier": "prettier . --check --ignore-unknown",
    "lint:prettier:fix": "prettier . --write --ignore-unknown",
    "lint:tsc": "tsc --noEmit",
    "playwright:install": "playwright install",
    "playwright:show-report": "playwright show-report",
    "playwright:codegen": "playwright codegen",
    "package:check": "npm exec --yes package-lock-utd@1.1.3",
    "remove:demo": "node ./scripts/removeDemo.cjs",
    "_prepare": "husky",
    "_postinstall": "msw init"
  },
  "bugs": {
    "url": "https://github.com/pplancq/dev-tools/issues"
  },
  "keywords": [
    "react",
    "template"
  ],
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "inversify": "^8.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-router": "^8.3.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@bdellegrazie/playwright-sonar-reporter": "^0.5.2",
    "@commitlint/cli": "^21.2.2",
    "@msw/playwright": "^0.6.7",
    "@playwright/test": "^1.62.1",
    "@pplancq/commitlint-config": "^4.0.6",
    "@pplancq/eslint-config": "^6.1.1",
    "@pplancq/prettier-config": "^4.0.2",
    "@pplancq/stylelint-config": "^6.1.1",
    "@rsbuild/core": "^2.1.13",
    "@rsbuild/plugin-eslint": "^2.0.2",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "monocart-coverage-reports": "^2.12.12",
    "msw": "^2.15.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rsbuild-plugin-stylelint": "^1.2.0",
    "stylelint": "^17.14.1",
    "tsc-files": "^1.1.4",
    "typescript": "^6.0.3",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^1.0.0-pre.5",
    "vitest-sonar-reporter": "^3.0.0"
  },
  "engines": {
    "node": ">=20.12.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "msw": {
    "workerDirectory": [
      "./public"
    ]
  }
}
